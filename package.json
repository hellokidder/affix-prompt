{
  "name": "affix-prompt",
  "version": "1.0.0",
  "description": "pi 扩展：transcript 中「用户输入消息」的 Affix 吸顶（类似 antd Affix），统一 maxRows 缩略模型，fullscreen TUI 模式",
  "type": "module",
  "main": "index.ts",
  "piConfig": {
    "configDir": ".pi"
  },
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24",
    "typescript": "^5"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "tui",
    "affix",
    "sticky",
    "prompt"
  ],
  "license": "MIT"
}
